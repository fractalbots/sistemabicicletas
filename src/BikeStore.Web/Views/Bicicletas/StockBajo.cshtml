@model List<InventarioBicicleta>
@{ ViewData["Title"] = "Stock bajo"; }

<h1 class="bs-titulo">Reposicion de inventario</h1>
<p class="bs-subtitulo">Resultado del procedimiento almacenado <code>sp_BicicletasStockBajo</code>.</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Marca</th><th>Modelo</th><th>Categoria</th>
                    <th class="text-end">Stock</th><th class="text-end">Minimo</th>
                    <th class="text-end">Faltante</th><th>Estado</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-muted py-4 text-center">Todo el inventario esta por encima del minimo.</td></tr>
            }
            @foreach (var b in Model)
            {
                <tr>
                    <td class="fw-semibold">@b.Marca</td>
                    <td>@b.Modelo</td>
                    <td>@b.Categoria</td>
                    <td class="text-end">@b.Stock</td>
                    <td class="text-end">@b.StockMinimo</td>
                    <td class="text-end fw-semibold">@(Math.Max(0, b.StockMinimo - b.Stock))</td>
                    <td>
                        <span class="bs-estado @(b.EstadoStock == "AGOTADO" ? "bs-estado-agotado" : "bs-estado-bajo")">
                            @b.EstadoStock
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

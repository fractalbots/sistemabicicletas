@model FiltroInventarioViewModel
@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="bs-titulo">Inventario de bicicletas</h1>
        <p class="bs-subtitulo">Datos de la vista <code>vw_InventarioBicicletas</code> a traves de la API REST.</p>

        <span class="badge bg-primary mb-2">
            @Model.Resultados.Count bicicleta(s) encontrada(s)
        </span>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva bicicleta</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Marca</label>
                <input name="marca" value="@Model.Marca" class="form-control form-control-sm" placeholder="Trek, Giant..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Modelo</label>
                <input name="modelo" value="@Model.Modelo" class="form-control form-control-sm" placeholder="Marlin 7..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Categoria</label>
                <select name="idCategoria" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.IdCategoria" selected="@(Model.IdCategoria == c.IdCategoria)">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Buscar</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary flex-grow-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Categoria</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Stock</th>
                    <th>Estado stock</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Resultados.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted py-4 text-center">
                            No se encontraron bicicletas con esos criterios.
                        </td>
                    </tr>
                }

                @foreach (var b in Model.Resultados)
                {
                    <tr>
                        <td class="fw-semibold">@b.Marca</td>
                        <td>@b.Modelo</td>
                        <td>@b.Categoria</td>
                        <td class="text-end">@Formato.Dinero(b.Precio)</td>
                        <td class="text-end">@b.Stock</td>
                        <td>
                            <span class="bs-estado @(b.EstadoStock == "AGOTADO" ? "bs-estado-agotado"
                                                                               : b.EstadoStock == "STOCK BAJO" ? "bs-estado-bajo"
                                                                               : "bs-estado-disponible")">
                                @b.EstadoStock
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Edit"
                               asp-route-id="@b.IdBicicleta">
                                Editar
                            </a>

                            <form asp-action="Desactivar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.IdBicicleta" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Desactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
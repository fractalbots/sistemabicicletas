@model List<InventarioBicicleta>
@{
    ViewData["Title"] = "Inventario";
    var categorias = ViewBag.Categorias as List<Categoria> ?? new List<Categoria>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Inventario de bicicletas</h1>
        <p class="text-muted mb-0 small">
            Datos de la vista vw_InventarioBicicletas vía API REST
        </p>

        <p class="mt-2 mb-0">
            <span class="badge text-bg-primary">
                @Model.Count bicicleta@(Model.Count == 1 ? "" : "s") encontrada@(Model.Count == 1 ? "" : "s")
            </span>
        </p>
    </div>

    <a class="btn btn-primary" asp-action="Create">
        Nueva bicicleta
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">

            <div class="col-md-3">
                <label class="form-label small text-muted">Marca</label>
                <input name="marca"
                       value="@ViewBag.Marca"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">Modelo</label>
                <input name="modelo"
                       value="@ViewBag.Modelo"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">Categoría</label>

                <select name="idCategoria" class="form-select">
                    <option value="">Todas</option>

                    @foreach (var c in categorias)
                    {
                        <option value="@c.IdCategoria"
                                selected="@(ViewBag.IdCategoria as int? == c.IdCategoria)">
                            @c.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit"
                        class="btn btn-outline-primary w-100">
                    Buscar
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Limpiar
                </a>
            </div>

        </form>
    </div>
</div>

<div class="card">

    <div class="table-responsive">

        <table class="table table-hover tabla-compacta mb-0 align-middle">

            <thead class="table-light">
                <tr>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Stock</th>
                    <th>Estado stock</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-4">

                            No se encontraron bicicletas con esos criterios.

                        </td>
                    </tr>
                }

                @foreach (var b in Model)
                {
                    <tr class="@(b.Estado ? "" : "table-secondary")">

                        <td class="fw-semibold">
                            @b.Marca
                        </td>

                        <td>
                            @b.Modelo
                        </td>

                        <td class="text-muted">
                            @b.Categoria
                        </td>

                        <td class="text-end">
                            $@b.Precio.ToString("N2")
                        </td>

                        <td class="text-end">
                            @b.Stock
                        </td>

                        <td>

                            @switch (b.EstadoStock)
                            {
                                case "AGOTADO":

                                    <span class="badge text-bg-danger">
                                        AGOTADO
                                    </span>

                                    break;

                                case "STOCK BAJO":

                                    <span class="badge text-bg-warning">
                                        STOCK BAJO
                                    </span>

                                    break;

                                default:

                                    <span class="badge text-bg-success">
                                        DISPONIBLE
                                    </span>

                                    break;
                            }

                        </td>

                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@b.IdBicicleta"
                               class="btn btn-sm btn-outline-secondary">

                                Editar

                            </a>

                            @if (b.Estado)
                            {
                                <form asp-action="Desactivar"
                                      asp-route-id="@b.IdBicicleta"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('¿Desactivar esta bicicleta del catálogo?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">

                                        Desactivar

                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
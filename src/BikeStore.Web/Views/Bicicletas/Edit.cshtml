@model BicicletaFormViewModel
@{ ViewData["Title"] = "Editar bicicleta"; }

<h1 class="bs-titulo">Editar bicicleta</h1>
<p class="bs-subtitulo">Se actualiza mediante <code>PUT /api/bicicletas/@Model.IdBicicleta</code>.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdBicicleta" />
            <div asp-validation-summary="All" class="text-danger small"></div>

            <div class="col-md-4">
                <label class="form-label bs-obligatorio">Categoria</label>
                <select asp-for="Datos.IdCategoria" class="form-select">
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.IdCategoria" selected="@(Model.Datos.IdCategoria == c.IdCategoria)">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label bs-obligatorio">Marca</label>
                <input asp-for="Datos.Marca" class="form-control" />
                <span asp-validation-for="Datos.Marca" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label bs-obligatorio">Modelo</label>
                <input asp-for="Datos.Modelo" class="form-control" />
                <span asp-validation-for="Datos.Modelo" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Descripcion</label>
                <input asp-for="Datos.Descripcion" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label bs-obligatorio">Precio</label>
                <input asp-for="Datos.Precio" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Datos.Precio" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Stock</label>
                <input asp-for="Datos.Stock" type="number" min="0" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Stock minimo</label>
                <input asp-for="Datos.StockMinimo" type="number" min="0" class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="Datos.Estado" class="form-check-input" />
                    <label class="form-check-label" asp-for="Datos.Estado">Activa</label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

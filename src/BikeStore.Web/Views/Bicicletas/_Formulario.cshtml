@model BicicletaDto
@{
    var categorias = ViewBag.Categorias as List<Categoria> ?? new List<Categoria>();
}

<div asp-validation-summary="All" class="alert alert-danger d-none-if-empty"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Marca" class="form-label">Marca</label>
        <input asp-for="Marca" class="form-control" />
        <span asp-validation-for="Marca" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Modelo" class="form-label">Modelo</label>
        <input asp-for="Modelo" class="form-control" />
        <span asp-validation-for="Modelo" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="IdCategoria" class="form-label">Categoría</label>
        <select asp-for="IdCategoria" class="form-select">
            <option value="">Seleccione…</option>
            @foreach (var c in categorias)
            {
                <option value="@c.IdCategoria">@c.Nombre</option>
            }
        </select>
        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Precio" class="form-label">Precio (USD)</label>
        <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" rows="2" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Stock" class="form-label">Stock actual</label>
        <input asp-for="Stock" type="number" min="0" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
        <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
        <span asp-validation-for="StockMinimo" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="Estado" class="form-check-input" />
            <label asp-for="Estado" class="form-check-label">Activa en el catálogo</label>
        </div>
    </div>
</div>

@model ClienteDto

<div asp-validation-summary="All" class="alert alert-danger d-none-if-empty"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Cedula" class="form-label">Cédula</label>
        <input asp-for="Cedula" class="form-control" maxlength="10" placeholder="1723456789" />
        <span asp-validation-for="Cedula" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Nombres" class="form-label">Nombres</label>
        <input asp-for="Nombres" class="form-control" />
        <span asp-validation-for="Nombres" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Apellidos" class="form-label">Apellidos</label>
        <input asp-for="Apellidos" class="form-control" />
        <span asp-validation-for="Apellidos" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Telefono" class="form-label">Teléfono</label>
        <input asp-for="Telefono" class="form-control" placeholder="0991234567" />
        <span asp-validation-for="Telefono" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Correo" class="form-label">Correo electrónico</label>
        <input asp-for="Correo" type="email" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label">Dirección</label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Cliente activo</label>
        </div>
    </div>
</div>

@model List<Cliente>
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="bs-titulo">Clientes</h1>
        <p class="bs-subtitulo">@Model.Count registro(s). Consulta a <code>GET /api/clientes</code>.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Buscar por cedula</label>
                <input name="cedula" value="@ViewBag.Cedula" class="form-control form-control-sm"
                       placeholder="1723456789" maxlength="10" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver todos</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Cedula</th><th>Nombre completo</th><th>Telefono</th>
                    <th>Correo</th><th>Estado</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-muted py-4 text-center">No hay clientes que mostrar.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Cedula</td>
                    <td class="fw-semibold">@c.Nombres @c.Apellidos</td>
                    <td>@(string.IsNullOrWhiteSpace(c.Telefono) ? "-" : c.Telefono)</td>
                    <td>@(string.IsNullOrWhiteSpace(c.Correo) ? "-" : c.Correo)</td>
                    <td>
                        <span class="bs-estado @(c.Activo ? "bs-estado-disponible" : "bs-estado-inactivo")">
                            @(c.Activo ? "ACTIVO" : "INACTIVO")
                        </span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Historial" asp-route-id="@c.IdCliente">Historial</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.IdCliente">Editar</a>
                        @if (c.Activo)
                        {
                            <form asp-action="Desactivar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.IdCliente" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

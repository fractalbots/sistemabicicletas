@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Clientes</h1>
        <p class="text-muted mb-0 small">@Model.Count registro(s)</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover tabla-compacta mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Cédula</th>
                    <th>Nombre completo</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Aún no hay clientes registrados.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr class="@(c.Activo ? "" : "table-secondary")">
                        <td><code>@c.Cedula</code></td>
                        <td class="fw-semibold">@c.Nombres @c.Apellidos</td>
                        <td>@(string.IsNullOrWhiteSpace(c.Telefono) ? "—" : c.Telefono)</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(c.Correo) ? "—" : c.Correo)</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Historial" asp-route-id="@c.IdCliente"
                               class="btn btn-sm btn-outline-primary">Historial</a>
                            <a asp-action="Edit" asp-route-id="@c.IdCliente"
                               class="btn btn-sm btn-outline-secondary">Editar</a>
                            @if (c.Activo)
                            {
                                <form asp-action="Desactivar" asp-route-id="@c.IdCliente"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('¿Desactivar este cliente?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Desactivar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model NuevaVentaViewModel
@{ ViewData["Title"] = "Nueva venta"; }

<h1 class="bs-titulo">Nueva venta</h1>
<p class="bs-subtitulo">
    Los importes que se muestran aqui son una estimacion. El calculo y la validacion
    definitivos los realiza el servidor mediante <code>sp_RegistrarVenta</code>.
</p>

<form asp-action="Create" method="post" id="formVenta">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small">
            @foreach (var estado in ViewData.ModelState.Values)
            {
                foreach (var err in estado.Errors)
                {
                    <div>@err.ErrorMessage</div>
                }
            }
        </div>
    }

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold">1. Cliente</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <select asp-for="IdCliente" class="form-select">
                        <option value="0">Seleccione un cliente...</option>
                        @foreach (var c in Model.Clientes)
                        {
                            <option value="@c.IdCliente">@c.Cedula &mdash; @c.Nombres @c.Apellidos</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Clientes" asp-action="Create" class="btn btn-outline-secondary w-100">Registrar cliente nuevo</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold">2. Productos</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Bicicleta</label>
                    <select id="selBicicleta" class="form-select">
                        <option value="">Seleccione...</option>
                        @foreach (var b in Model.Bicicletas)
                        {
                            <option value="@b.IdBicicleta"
                                    data-precio="@b.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-stock="@b.Stock"
                                    data-nombre="@b.Marca @b.Modelo">
                                @b.Marca @b.Modelo &mdash; @Formato.Dinero(b.Precio) (stock: @b.Stock)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cantidad</label>
                    <input type="number" id="txtCantidad" class="form-control" value="1" min="1" />
                </div>
                <div class="col-md-3">
                    <button type="button" id="btnAgregar" class="btn btn-outline-primary w-100">Agregar</button>
                </div>
            </div>
            <div id="avisoLinea" class="text-danger small mt-2"></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold">3. Resumen</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Bicicleta</th><th class="text-end">Cantidad</th>
                        <th class="text-end">Precio</th><th class="text-end">Subtotal</th><th></th>
                    </tr>
                </thead>
                <tbody id="cuerpoLineas">
                    <tr id="filaVacia"><td colspan="5" class="text-muted text-center py-3">Agregue bicicletas a la venta.</td></tr>
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end">Subtotal estimado</td><td class="text-end" id="celSubtotal">$0.00</td><td></td></tr>
                    <tr><td colspan="3" class="text-end">IVA (@Model.PorcentajeIva.ToString("0.##")%)</td><td class="text-end" id="celIva">$0.00</td><td></td></tr>
                    <tr class="fw-bold"><td colspan="3" class="text-end">Total estimado</td><td class="text-end" id="celTotal">$0.00</td><td></td></tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Registrar venta</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
<script>
(function () {
    var IVA = @Model.PorcentajeIva.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var lineas = [];

    var selBici   = document.getElementById('selBicicleta');
    var txtCant   = document.getElementById('txtCantidad');
    var btnAdd    = document.getElementById('btnAgregar');
    var cuerpo    = document.getElementById('cuerpoLineas');
    var filaVacia = document.getElementById('filaVacia');
    var aviso     = document.getElementById('avisoLinea');

    function dinero(valor) {
        return '$' + valor.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function pintar() {
        cuerpo.querySelectorAll('tr.linea').forEach(function (f) { f.remove(); });
        filaVacia.style.display = lineas.length === 0 ? '' : 'none';

        var subtotal = 0;

        lineas.forEach(function (l, i) {
            var importe = l.precio * l.cantidad;
            subtotal += importe;

            var tr = document.createElement('tr');
            tr.className = 'linea';
            tr.innerHTML =
                '<td>' + l.nombre + '</td>' +
                '<td class="text-end">' + l.cantidad + '</td>' +
                '<td class="text-end">' + dinero(l.precio) + '</td>' +
                '<td class="text-end">' + dinero(importe) + '</td>' +
                '<td class="text-end">' +
                    '<button type="button" class="btn btn-sm btn-outline-danger" data-quitar="' + i + '">Quitar</button>' +
                    '<input type="hidden" name="Detalle[' + i + '].IdBicicleta" value="' + l.id + '" />' +
                    '<input type="hidden" name="Detalle[' + i + '].Cantidad" value="' + l.cantidad + '" />' +
                '</td>';
            cuerpo.appendChild(tr);
        });

        var iva = Math.round(subtotal * IVA) / 100;
        document.getElementById('celSubtotal').textContent = dinero(subtotal);
        document.getElementById('celIva').textContent = dinero(iva);
        document.getElementById('celTotal').textContent = dinero(subtotal + iva);
    }

    btnAdd.addEventListener('click', function () {
        aviso.textContent = '';

        var opcion = selBici.options[selBici.selectedIndex];
        if (!selBici.value) { aviso.textContent = 'Seleccione una bicicleta.'; return; }

        var cantidad = parseInt(txtCant.value, 10);
        if (isNaN(cantidad) || cantidad <= 0) { aviso.textContent = 'La cantidad debe ser mayor que cero.'; return; }

        var id     = parseInt(selBici.value, 10);
        var stock  = parseInt(opcion.getAttribute('data-stock'), 10);
        var precio = parseFloat(opcion.getAttribute('data-precio'));
        var nombre = opcion.getAttribute('data-nombre');

        var existente = lineas.filter(function (l) { return l.id === id; })[0];
        var acumulada = cantidad + (existente ? existente.cantidad : 0);

        if (acumulada > stock) {
            aviso.textContent = 'Solo hay ' + stock + ' unidad(es) en stock de este modelo.';
            return;
        }

        if (existente) { existente.cantidad = acumulada; }
        else { lineas.push({ id: id, nombre: nombre, precio: precio, cantidad: cantidad }); }

        txtCant.value = 1;
        selBici.selectedIndex = 0;
        pintar();
    });

    cuerpo.addEventListener('click', function (e) {
        var indice = e.target.getAttribute('data-quitar');
        if (indice === null) return;
        lineas.splice(parseInt(indice, 10), 1);
        pintar();
    });

    document.getElementById('formVenta').addEventListener('submit', function (e) {
        if (lineas.length === 0) {
            e.preventDefault();
            aviso.textContent = 'Agregue al menos una bicicleta antes de registrar la venta.';
        }
    });

    pintar();
})();
</script>
}

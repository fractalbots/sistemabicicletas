@model List<Venta>
@{ ViewData["Title"] = "Ventas"; }

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="bs-titulo">Historial de ventas</h1>
        <p class="bs-subtitulo">@Model.Count venta(s) registradas. Consulta a <code>GET /api/ventas</code>.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva venta</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th><th>Fecha</th><th>Cliente</th>
                    <th class="text-end">Subtotal</th><th class="text-end">IVA</th>
                    <th class="text-end">Total</th><th>Estado</th><th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-muted py-4 text-center">Todavia no hay ventas registradas.</td></tr>
            }
            @foreach (var v in Model)
            {
                <tr>
                    <td class="fw-semibold">@v.IdVenta</td>
                    <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(v.Cliente is null ? "-" : v.Cliente.Nombres + " " + v.Cliente.Apellidos)</td>
                    <td class="text-end">@Formato.Dinero(v.Subtotal)</td>
                    <td class="text-end">@Formato.Dinero(v.Iva)</td>
                    <td class="text-end fw-semibold">@Formato.Dinero(v.Total)</td>
                    <td><span class="bs-estado @(v.Estado == "EMITIDA" ? "bs-emitida" : "bs-anulada")">@v.Estado</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.IdVenta">Ver factura</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@model List<Venta>
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Ventas registradas</h1>
        <p class="text-muted mb-0 small">@Model.Count comprobante(s)</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva venta</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover tabla-compacta mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">IVA</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Todavía no hay ventas registradas.
                        </td>
                    </tr>
                }
                @foreach (var v in Model)
                {
                    <tr class="@(v.Estado == "ANULADA" ? "table-secondary" : "")">
                        <td class="fw-semibold">@v.IdVenta</td>
                        <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Cliente?.Nombres @v.Cliente?.Apellidos</td>
                        <td class="text-end">$@v.Subtotal.ToString("N2")</td>
                        <td class="text-end text-muted">
                            $@v.Iva.ToString("N2")
                            <span class="small">(@v.PorcentajeIva.ToString("N0")%)</span>
                        </td>
                        <td class="text-end fw-semibold">$@v.Total.ToString("N2")</td>
                        <td>
                            @if (v.Estado == "EMITIDA")
                            {
                                <span class="badge text-bg-success">EMITIDA</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">ANULADA</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@v.IdVenta"
                               class="btn btn-sm btn-outline-primary">Ver factura</a>
                            @if (v.Estado == "EMITIDA")
                            {
                                <form asp-action="Anular" asp-route-id="@v.IdVenta"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('¿Anular la venta @v.IdVenta? El stock será restituido.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Anular
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

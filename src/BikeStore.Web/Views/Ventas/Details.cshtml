@model Venta
@{
    ViewData["Title"] = $"Factura #{Model.IdVenta}";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">Factura #@Model.IdVenta</h1>
        <p class="text-muted mb-0 small">@Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy - HH:mm")</p>
    </div>
    <div>
        @if (Model.Estado == "EMITIDA")
        {
            <span class="badge text-bg-success fs-6">EMITIDA</span>
        }
        else
        {
            <span class="badge text-bg-secondary fs-6">ANULADA</span>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-white"><strong>Cliente</strong></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="fw-semibold">@Model.Cliente?.Nombres @Model.Cliente?.Apellidos</div>
                <div class="text-muted small">Cédula: @Model.Cliente?.Cedula</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted small">@Model.Cliente?.Correo</div>
                <div class="text-muted small">@Model.Cliente?.Telefono</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-white"><strong>Detalle</strong></div>
    <div class="table-responsive">
        <table class="table tabla-compacta mb-0">
            <thead class="table-light">
                <tr>
                    <th>Bicicleta</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Precio unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">@d.Bicicleta?.Marca</span>
                            @d.Bicicleta?.Modelo
                        </td>
                        <td class="text-end">@d.Cantidad</td>
                        <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">$@d.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="3" class="text-end">Subtotal</td>
                    <td class="text-end">$@Model.Subtotal.ToString("N2")</td>
                </tr>
                <tr>
                    <td colspan="3" class="text-end">
                        IVA (@Model.PorcentajeIva.ToString("N0")%)
                    </td>
                    <td class="text-end">$@Model.Iva.ToString("N2")</td>
                </tr>
                <tr class="fw-semibold fs-5">
                    <td colspan="3" class="text-end">Total</td>
                    <td class="text-end">$@Model.Total.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a ventas</a>
    @if (Model.Estado == "EMITIDA")
    {
        <form asp-action="Anular" asp-route-id="@Model.IdVenta" method="post"
              onsubmit="return confirm('¿Anular esta venta? El stock será restituido.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">Anular venta</button>
        </form>
    }
</div>

<p class="text-muted small mt-3 mb-0">
    El porcentaje de IVA se almacena en cada transacción, de modo que las facturas
    históricas conservan la tasa vigente al momento de su emisión.
</p>
